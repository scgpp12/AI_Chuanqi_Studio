  "shot_id": 6,
  "sort": 0,
  "character_id": null,
  "speaker": "旁白",
  "line": "这四个人要是也回不来，就没有人可以去了。",
  "delivery": "",
  "start_time": null,
  "created_at": "2026-11-15 13:49:13",
  "updated_at": "2026-11-15 13:49:13"
 },
 {
